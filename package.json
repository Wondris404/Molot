    "start": "node scripts/next-local.mjs start --hostname 127.0.0.1",
    "lint": "eslint .",
    "db:init": "tsx scripts/init-db.ts",
    "test": "tsx --test tests/core.test.ts tests/global.test.ts tests/intelligence.test.ts tests/documents.test.ts tests/result-recommendation.test.ts tests/backup-regressions.test.ts tests/prediction-regressions.test.ts tests/mini-ai.test.ts",
    "test:ml": "tsx --test --test-name-pattern=DEMO tests/intelligence.test.ts",
    "test:mini-ai": "tsx scripts/mini-ai-benchmark.ts",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test:clean": "node scripts/clean-test-data.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "desktop:prepare": "node scripts/desktop.mjs prepare",
    "desktop:dev": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build",
    "release": "node scripts/release.mjs",
    "release:audit": "node scripts/release-audit.mjs",
    "version:set": "node scripts/version.mjs",
    "version:preserve": "node scripts/preserve-release.mjs",
    "test:installer": "node scripts/installer-smoke.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lucide-react": "^0.577.0",
    "next": "^16.0.0",
